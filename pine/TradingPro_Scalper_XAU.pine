// This Pine Script™ code is subject to the terms of the Mozilla Public License 2.0
// TradingPro Scalper XAU — indicador de scalping para XAUUSD (M1 / M5)
// Replica en el gráfico la lógica principal de TradingProEA:
//   1) Killzones Londres / NY en hora RD (UTC-4)
//   2) Liquidity Sweep + MSS con vela de desplazamiento (estrategia sweep_displacement)
//   3) Pullback a EMA en tendencia (estrategia ema_pullback)
//   4) FVG, VWAP de sesión, PDH/PDL y squeeze como contexto
// Todas las señales se confirman al CIERRE de la vela (no repintan).
//@version=6
indicator("TradingPro Scalper XAU", shorttitle = "TP Scalper", overlay = true, max_boxes_count = 200, max_lines_count = 200, max_labels_count = 200)

// ─────────────────────────── INPUTS ───────────────────────────
grpT = "Tendencia"
emaFastLen   = input.int(9, "EMA rápida", minval = 1, group = grpT)
emaSlowLen   = input.int(21, "EMA lenta", minval = 1, group = grpT)
emaTrendLen  = input.int(200, "EMA tendencia", minval = 1, group = grpT)
htfTf        = input.timeframe("15", "Timeframe del sesgo", group = grpT)
htfEmaLen    = input.int(50, "EMA del sesgo (en ese timeframe)", minval = 1, group = grpT)
useBias      = input.bool(true, "Filtrar señales con el sesgo HTF", group = grpT)

grpS = "Sesiones (hora RD)"
tz       = input.string("America/Santo_Domingo", "Zona horaria", group = grpS)
kzLondon = input.session("0300-0600", "Killzone Londres", group = grpS)
kzNY     = input.session("0900-1200", "Killzone Nueva York", group = grpS)
onlyKZ   = input.bool(true, "Señales solo dentro de killzone", group = grpS)
showKZ   = input.bool(true, "Sombrear killzones", group = grpS)

grpL = "Liquidez / Estructura"
pivotLen    = input.int(5, "Largo de pivote (swing)", minval = 2, group = grpL)
minorLook   = input.int(8, "Velas para el swing menor (MSS)", minval = 2, group = grpL)
mssWindow   = input.int(15, "Velas máx. entre sweep y MSS", minval = 1, group = grpL)
useSweepSig = input.bool(true, "Señal: Sweep + MSS", group = grpL)
usePullSig  = input.bool(true, "Señal: Pullback a EMA", group = grpL)
showPD      = input.bool(true, "Mostrar PDH / PDL", group = grpL)

grpF = "Fair Value Gaps"
showFVG   = input.bool(true, "Mostrar FVG", group = grpF)
fvgMinAtr = input.float(0.25, "Tamaño mínimo FVG (x ATR)", minval = 0, step = 0.05, group = grpF)
fvgMax    = input.int(10, "FVG máximos en pantalla", minval = 1, maxval = 100, group = grpF)

grpR = "Riesgo"
atrLen     = input.int(14, "ATR", minval = 1, group = grpR)
slBuffer   = input.float(0.30, "Buffer del SL (en precio)", minval = 0, step = 0.05, group = grpR)
rr         = input.float(2.0, "R:R del TP", minval = 0.5, step = 0.25, group = grpR)
minDispAtr = input.float(1.2, "Cuerpo mínimo vela de desplazamiento (x ATR)", minval = 0, step = 0.1, group = grpR)
maxSlAtr   = input.float(3.0, "SL máximo permitido (x ATR)", minval = 0.5, step = 0.25, group = grpR)
showLevels = input.bool(true, "Dibujar entrada / SL / TP", group = grpR)

grpV = "VWAP / Squeeze / Panel"
showVWAP = input.bool(true, "VWAP de sesión + bandas", group = grpV)
vwapMult = input.float(1.0, "Desviaciones de las bandas", minval = 0.5, step = 0.5, group = grpV)
showSqz  = input.bool(true, "Marcar squeeze (BB dentro de Keltner)", group = grpV)
showDash = input.bool(true, "Mostrar panel", group = grpV)

// ─────────────────────────── CÁLCULOS BASE ───────────────────────────
atrV   = ta.atr(atrLen)
emaF   = ta.ema(close, emaFastLen)
emaS   = ta.ema(close, emaSlowLen)
emaT   = ta.ema(close, emaTrendLen)
body   = math.abs(close - open)

inLondon = not na(time(timeframe.period, kzLondon, tz))
inNY     = not na(time(timeframe.period, kzNY, tz))
inKZ     = inLondon or inNY
kzOk     = not onlyKZ or inKZ

// Sesgo HTF sin repintado: valor de la vela HTF ya cerrada
[htfClose, htfEma] = request.security(syminfo.tickerid, htfTf, [close[1], ta.ema(close, htfEmaLen)[1]], lookahead = barmerge.lookahead_on)
biasUp   = htfClose > htfEma
biasDown = htfClose < htfEma
longOk   = not useBias or biasUp
shortOk  = not useBias or biasDown

// Máximo / mínimo del día anterior (sin repintado)
[pdh, pdl] = request.security(syminfo.tickerid, "D", [high[1], low[1]], lookahead = barmerge.lookahead_on)

// VWAP anclado al día
[vwapMid, vwapUp, vwapDn] = ta.vwap(hlc3, timeframe.change("D"), vwapMult)

// Squeeze (TTM / LazyBear): Bollinger dentro de Keltner
bbBasis = ta.sma(close, 20)
bbDev   = 2.0 * ta.stdev(close, 20)
kcRange = 1.5 * ta.sma(ta.tr(true), 20)
sqzOn   = (bbBasis + bbDev) < (bbBasis + kcRange) and (bbBasis - bbDev) > (bbBasis - kcRange)

// ─────────────────────────── ESTRUCTURA / SWEEPS ───────────────────────────
ph = ta.pivothigh(high, pivotLen, pivotLen)
pl = ta.pivotlow(low, pivotLen, pivotLen)

var float lastSwingHigh = na
var float lastSwingLow  = na
if not na(ph)
    lastSwingHigh := ph
if not na(pl)
    lastSwingLow := pl

minorLow  = ta.lowest(low, minorLook)[1]
minorHigh = ta.highest(high, minorLook)[1]

// Sweep = mecha que rompe la liquidez y cierre de vuelta dentro
sweepHighSwing = not na(lastSwingHigh) and high > lastSwingHigh and close < lastSwingHigh
sweepHighPD    = not na(pdh) and high > pdh and close < pdh
sweepLowSwing  = not na(lastSwingLow) and low < lastSwingLow and close > lastSwingLow
sweepLowPD     = not na(pdl) and low < pdl and close > pdl
sweptHigh = sweepHighSwing or sweepHighPD
sweptLow  = sweepLowSwing or sweepLowPD

var int   bearSweepBar = na
var float bearSweepExt = na
var float bearSweepLvl = na
var float bearMssLvl   = na
var int   bullSweepBar = na
var float bullSweepExt = na
var float bullSweepLvl = na
var float bullMssLvl   = na

if sweptHigh
    bearSweepBar := bar_index
    bearSweepExt := high
    bearSweepLvl := sweepHighPD ? pdh : lastSwingHigh
    bearMssLvl   := minorLow
    if sweepHighSwing
        lastSwingHigh := na   // liquidez consumida
if sweptLow
    bullSweepBar := bar_index
    bullSweepExt := low
    bullSweepLvl := sweepLowPD ? pdl : lastSwingLow
    bullMssLvl   := minorHigh
    if sweepLowSwing
        lastSwingLow := na

// Seguimiento del sweep activo: nuevo extremo o invalidación
if not na(bearSweepBar) and bar_index > bearSweepBar
    if close > bearSweepLvl or bar_index - bearSweepBar > mssWindow
        bearSweepBar := na
    else if high > bearSweepExt
        bearSweepExt := high
if not na(bullSweepBar) and bar_index > bullSweepBar
    if close < bullSweepLvl or bar_index - bullSweepBar > mssWindow
        bullSweepBar := na
    else if low < bullSweepExt
        bullSweepExt := low

// MSS con desplazamiento
bigBody   = body >= minDispAtr * atrV
sweepSell = useSweepSig and not na(bearSweepBar) and bar_index > bearSweepBar and close < bearMssLvl and close < open and bigBody and shortOk and kzOk
sweepBuy  = useSweepSig and not na(bullSweepBar) and bar_index > bullSweepBar and close > bullMssLvl and close > open and bigBody and longOk and kzOk

// ─────────────────────────── PULLBACK A EMA ───────────────────────────
trendUp   = emaF > emaS and emaS > emaT
trendDown = emaF < emaS and emaS < emaT
pullBuyRaw  = trendUp and low <= emaS and close > emaF and close > open and longOk and kzOk
pullSellRaw = trendDown and high >= emaS and close < emaF and close < open and shortOk and kzOk
pullBuy  = usePullSig and pullBuyRaw and not pullBuyRaw[1]
pullSell = usePullSig and pullSellRaw and not pullSellRaw[1]

// ─────────────────────────── NIVELES DE LA OPERACIÓN ───────────────────────────
buySig  = (sweepBuy or pullBuy) and barstate.isconfirmed
sellSig = (sweepSell or pullSell) and barstate.isconfirmed

lo5 = ta.lowest(low, 5)
hi5 = ta.highest(high, 5)
slBuyRaw  = sweepBuy ? bullSweepExt - slBuffer : lo5 - slBuffer
slSellRaw = sweepSell ? bearSweepExt + slBuffer : hi5 + slBuffer
riskBuy   = close - slBuyRaw
riskSell  = slSellRaw - close

// Descarta señales con SL absurdo (vela gigante / noticia)
buySig  := buySig and riskBuy > 0 and riskBuy <= maxSlAtr * atrV
sellSig := sellSig and riskSell > 0 and riskSell <= maxSlAtr * atrV

tpBuy  = close + rr * riskBuy
tpSell = close - rr * riskSell

drawTrade(float entry, float sl, float tp, string tag, bool isBuy) =>
    col = isBuy ? color.green : color.red
    line.new(bar_index, entry, bar_index + 20, entry, color = color.gray, width = 1)
    line.new(bar_index, sl, bar_index + 20, sl, color = color.red, style = line.style_dashed)
    line.new(bar_index, tp, bar_index + 20, tp, color = color.green, style = line.style_dashed)
    txt = tag + "\nE " + str.tostring(entry, format.mintick) + "\nSL " + str.tostring(sl, format.mintick) + "\nTP " + str.tostring(tp, format.mintick)
    label.new(bar_index, isBuy ? low : high, txt, color = col, textcolor = color.white, style = isBuy ? label.style_label_up : label.style_label_down, size = size.small)

if buySig
    tagB = sweepBuy ? "BUY Sweep+MSS" : "BUY Pullback EMA"
    if showLevels
        drawTrade(close, slBuyRaw, tpBuy, tagB, true)
    alert(tagB + " XAU | E " + str.tostring(close, format.mintick) + " SL " + str.tostring(slBuyRaw, format.mintick) + " TP " + str.tostring(tpBuy, format.mintick), alert.freq_once_per_bar_close)
    bullSweepBar := na
if sellSig
    tagS = sweepSell ? "SELL Sweep+MSS" : "SELL Pullback EMA"
    if showLevels
        drawTrade(close, slSellRaw, tpSell, tagS, false)
    alert(tagS + " XAU | E " + str.tostring(close, format.mintick) + " SL " + str.tostring(slSellRaw, format.mintick) + " TP " + str.tostring(tpSell, format.mintick), alert.freq_once_per_bar_close)
    bearSweepBar := na

// ─────────────────────────── FVG ───────────────────────────
var array<box>  fvgBoxes  = array.new<box>()
var array<bool> fvgIsBull = array.new<bool>()

bullFvg = low > high[2] and (low - high[2]) >= fvgMinAtr * atrV
bearFvg = high < low[2] and (low[2] - high) >= fvgMinAtr * atrV

if showFVG and barstate.isconfirmed
    if bullFvg
        array.push(fvgBoxes, box.new(bar_index - 2, low, bar_index, high[2], border_color = na, bgcolor = color.new(color.teal, 80), extend = extend.right))
        array.push(fvgIsBull, true)
    if bearFvg
        array.push(fvgBoxes, box.new(bar_index - 2, low[2], bar_index, high, border_color = na, bgcolor = color.new(color.maroon, 80), extend = extend.right))
        array.push(fvgIsBull, false)
    // Borra FVG llenados por completo
    if array.size(fvgBoxes) > 0
        for i = array.size(fvgBoxes) - 1 to 0
            b      = array.get(fvgBoxes, i)
            isBull = array.get(fvgIsBull, i)
            filled = isBull ? low <= box.get_bottom(b) : high >= box.get_top(b)
            if filled and box.get_left(b) < bar_index - 2
                box.delete(b)
                array.remove(fvgBoxes, i)
                array.remove(fvgIsBull, i)
    // Límite de FVG en pantalla
    while array.size(fvgBoxes) > fvgMax
        box.delete(array.shift(fvgBoxes))
        array.shift(fvgIsBull)

// ─────────────────────────── PLOTS ───────────────────────────
bgcolor(showKZ and inLondon ? color.new(color.blue, 92) : showKZ and inNY ? color.new(color.orange, 92) : na, title = "Killzones")

plot(emaF, "EMA rápida", color = color.new(color.yellow, 0))
plot(emaS, "EMA lenta", color = color.new(color.orange, 0))
plot(emaT, "EMA tendencia", color = color.new(color.white, 30), linewidth = 2)

plot(showVWAP ? vwapMid : na, "VWAP", color = color.new(color.purple, 0), linewidth = 2)
plot(showVWAP ? vwapUp : na, "VWAP +", color = color.new(color.purple, 60))
plot(showVWAP ? vwapDn : na, "VWAP -", color = color.new(color.purple, 60))

plot(showPD ? pdh : na, "PDH", color = color.new(color.red, 30), style = plot.style_stepline)
plot(showPD ? pdl : na, "PDL", color = color.new(color.green, 30), style = plot.style_stepline)

plotshape(sweptHigh and barstate.isconfirmed, "Sweep de máximos", shape.xcross, location.abovebar, color.new(color.red, 40), size = size.tiny)
plotshape(sweptLow and barstate.isconfirmed, "Sweep de mínimos", shape.xcross, location.belowbar, color.new(color.green, 40), size = size.tiny)
plotshape(showSqz and sqzOn, "Squeeze", shape.circle, location.bottom, color.new(color.gray, 20), size = size.tiny)

plotshape(buySig, "BUY", shape.triangleup, location.belowbar, color.green, size = size.small)
plotshape(sellSig, "SELL", shape.triangledown, location.abovebar, color.red, size = size.small)

alertcondition(buySig, "TP Scalper BUY", "TP Scalper: señal de COMPRA en {{ticker}} a {{close}}")
alertcondition(sellSig, "TP Scalper SELL", "TP Scalper: señal de VENTA en {{ticker}} a {{close}}")
alertcondition(sweptHigh or sweptLow, "TP Scalper Sweep", "TP Scalper: sweep de liquidez en {{ticker}}")

// ─────────────────────────── PANEL ───────────────────────────
var table dash = table.new(position.top_right, 2, 5, bgcolor = color.new(color.black, 20), border_width = 1)
if showDash and barstate.islast
    sesion = inLondon ? "Londres KZ" : inNY ? "NY KZ" : "Fuera de KZ"
    sesgo  = biasUp ? "ALCISTA" : biasDown ? "BAJISTA" : "NEUTRO"
    table.cell(dash, 0, 0, "Sesgo " + htfTf, text_color = color.white, text_size = size.small)
    table.cell(dash, 1, 0, sesgo, text_color = biasUp ? color.lime : biasDown ? color.red : color.gray, text_size = size.small)
    table.cell(dash, 0, 1, "Sesión", text_color = color.white, text_size = size.small)
    table.cell(dash, 1, 1, sesion, text_color = inKZ ? color.yellow : color.gray, text_size = size.small)
    table.cell(dash, 0, 2, "ATR(" + str.tostring(atrLen) + ")", text_color = color.white, text_size = size.small)
    table.cell(dash, 1, 2, str.tostring(atrV, format.mintick), text_color = color.white, text_size = size.small)
    table.cell(dash, 0, 3, "Squeeze", text_color = color.white, text_size = size.small)
    table.cell(dash, 1, 3, sqzOn ? "SÍ (esperar ruptura)" : "No", text_color = sqzOn ? color.orange : color.gray, text_size = size.small)
    table.cell(dash, 0, 4, "Precio vs VWAP", text_color = color.white, text_size = size.small)
    table.cell(dash, 1, 4, na(vwapMid) ? "sin volumen" : close > vwapMid ? "Encima" : "Debajo", text_color = color.white, text_size = size.small)
